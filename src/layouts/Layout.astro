---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "Followbirds — The guide workspace for better birding tours",
  description = "Followbirds is building a guide workspace for creating tours, sharing sightings, and giving every guest a story to keep.",
  ogImage = "https://followbirds.com/og-image.jpg",
  canonicalUrl = "https://followbirds.com/",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="shortcut icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --bg: #f1f2f3;
        --panel: rgba(255, 255, 255, 0.72);
        --panel-strong: #ffffff;
        --ink: #17191c;
        --muted: #687078;
        --line: rgba(35, 40, 46, 0.14);
        --green: #559858;
        --green-deep: #1b5e20;
        --green-soft: #dce7c9;
        --purple: #2f1737;
        --purple-light: #594b66;
        --notable-purple: #7c3aed;
        --red: #a83232;
        --shadow: 0 18px 50px rgba(49, 79, 25, 0.12);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      :where(a, button, summary):focus-visible {
        outline: 3px solid var(--notable-purple);
        outline-offset: 4px;
      }

      :where([id]):target {
        scroll-margin-top: 6rem;
      }

      body {
        font-family: 'Fira Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(255, 255, 255, 0.96), transparent 36%),
          radial-gradient(circle at top right, rgba(224, 227, 230, 0.62), transparent 30%),
          radial-gradient(circle at 78% 52%, rgba(168, 50, 50, 0.045), transparent 22%),
          linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Typography */
      h1 {
        font-family: 'Fira Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: clamp(2.6rem, 5.5vw, 4.9rem);
        font-weight: 600;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: var(--ink);
        letter-spacing: -0.04em;
      }

      h2 {
        font-family: 'Fira Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: clamp(1.7rem, 3.6vw, 3.05rem);
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 1.25rem;
        color: var(--ink);
        letter-spacing: -0.03em;
      }

      h3 {
        font-family: 'Fira Sans', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 0.6rem;
        color: var(--ink);
      }

      p {
        margin-bottom: 1rem;
        color: var(--muted);
        line-height: 1.7;
      }

      /* Section label overline */
      .section-label {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--green);
        margin-bottom: 1rem;
      }

      /* Utilities */
      .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .section {
        padding: 5rem 0;
      }

      @media (max-width: 768px) {
        .section {
          padding: 3.5rem 0;
        }
      }

      /* Buttons */
      .btn {
        display: inline-block;
        padding: 0.85rem 1.85rem;
        border-radius: 0.65rem;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn-primary {
        background: linear-gradient(180deg, #559858 0%, #1b5e20 100%);
        color: white;
        box-shadow: 0 10px 20px rgba(27, 94, 32, 0.2);
      }

      .btn-primary:hover {
        transform: translateY(-1px);
        filter: brightness(1.03);
      }

      .btn-secondary {
        background-color: rgba(255, 255, 255, 0.72);
        color: var(--purple);
        border: 1px solid rgba(35, 40, 46, 0.24);
        backdrop-filter: blur(12px);
      }

      .btn-secondary:hover {
        background-color: #fff;
        border-color: rgba(35, 40, 46, 0.42);
        color: var(--purple-light);
      }

      /* Grid */
      .grid {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      .grid-2 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      }

      .grid-3 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      .grid-7 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }

      .grid-6 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      }

      @media (max-width: 768px) {
        .grid-2 {
          grid-template-columns: 1fr;
        }

        .grid-7 {
          grid-template-columns: repeat(2, 1fr);
        }

        .grid-6 {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    <script src="../scripts/site-i18n.ts"></script>
  </body>
</html>
