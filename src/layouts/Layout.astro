---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "FollowBirds — Birdwatching Tours, Checklists and Reports",
  description = "FollowBirds helps birding guides run tours and helps birdwatchers save observations, checklists and beautiful reports forever.",
  ogImage = "https://followbirds.com/og-image.jpg",
  canonicalUrl = "https://followbirds.com/",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        color: #1a1a1a;
        background-color: #faf9f7;
        line-height: 1.6;
      }

      /* Typography */
      h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
      }

      h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }

      p {
        margin-bottom: 1rem;
        color: #333;
      }

      /* Utilities */
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .section {
        padding: 4rem 0;
      }

      @media (max-width: 768px) {
        .section {
          padding: 3rem 0;
        }
      }

      /* Buttons */
      .btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn-primary {
        background-color: #1b5e20;
        color: white;
      }

      .btn-primary:hover {
        background-color: #0d3616;
      }

      .btn-secondary {
        background-color: transparent;
        color: #1b5e20;
        border: 2px solid #1b5e20;
      }

      .btn-secondary:hover {
        background-color: #f0f0f0;
      }

      /* Grid */
      .grid {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      .grid-2 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      }

      @media (max-width: 768px) {
        .grid-2 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
