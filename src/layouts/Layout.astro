---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "FollowBirds — Birdwatching Tours, Checklists and Reports",
  description = "FollowBirds helps birding guides run tours and helps birdwatchers save observations, checklists and beautiful reports forever.",
  ogImage = "https://followbirds.com/og-image.jpg",
  canonicalUrl = "https://followbirds.com/",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #142016;
        background-color: #FAF7EF;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Typography */
      h1 {
        font-family: 'DM Serif Display', Georgia, serif;
        font-size: clamp(2.4rem, 5.5vw, 3.4rem);
        font-weight: 400;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: #142016;
      }

      h2 {
        font-family: 'DM Serif Display', Georgia, serif;
        font-size: clamp(1.5rem, 3.5vw, 2.4rem);
        font-weight: 400;
        line-height: 1.2;
        margin-bottom: 1.25rem;
        color: #142016;
      }

      h3 {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 0.6rem;
        color: #142016;
      }

      p {
        margin-bottom: 1rem;
        color: #5E6B60;
        line-height: 1.7;
      }

      /* Section label overline */
      .section-label {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #2F7D32;
        margin-bottom: 1rem;
      }

      /* Utilities */
      .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .section {
        padding: 5.5rem 0;
      }

      @media (max-width: 768px) {
        .section {
          padding: 3.5rem 0;
        }
      }

      /* Buttons */
      .btn {
        display: inline-block;
        padding: 0.85rem 1.85rem;
        border-radius: 0.65rem;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn-primary {
        background-color: #2F7D32;
        color: white;
      }

      .btn-primary:hover {
        background-color: #1b5e20;
      }

      .btn-secondary {
        background-color: transparent;
        color: #2F7D32;
        border: 2px solid #2F7D32;
      }

      .btn-secondary:hover {
        background-color: rgba(47, 125, 50, 0.05);
        border-color: #1b5e20;
        color: #1b5e20;
      }

      /* Grid */
      .grid {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      .grid-2 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      }

      .grid-3 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }

      .grid-7 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }

      .grid-6 {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      }

      @media (max-width: 768px) {
        .grid-2 {
          grid-template-columns: 1fr;
        }

        .grid-7 {
          grid-template-columns: repeat(2, 1fr);
        }

        .grid-6 {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
