---
// Header Navigation Component
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <div class="logo">
        <a href="/">
          <span class="logo-icon">🦅</span>
          <span class="logo-text">FollowBirds</span>
        </a>
      </div>

      <ul class="nav-links">
        <li><a href="#how-it-works">How it works</a></li>
        <li><a href="#for-guides">For guides</a></li>
        <li><a href="#tour-report">Reports</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>

      <div class="nav-ctas">
        <a href="#guide-program" class="btn btn-primary">Become a Guide</a>
        <a href="https://followbirdsapp.web.app" class="nav-link-secondary" target="_blank">
          Web App
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: #fff;
    border-bottom: 1px solid #f0f0f0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0;
    gap: 2rem;
  }

  .logo a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.25rem;
    color: #142016;
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .nav-links {
    display: none;
    list-style: none;
    gap: 2.5rem;
    flex: 1;
  }

  .nav-links a {
    text-decoration: none;
    color: #5E6B60;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #2F7D32;
  }

  .nav-ctas {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .nav-link-secondary {
    text-decoration: none;
    color: #5E6B60;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-link-secondary:hover {
    color: #2F7D32;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }

    .nav-link-secondary {
      display: inline;
    }
  }

  @media (max-width: 768px) {
    .nav-link-secondary {
      display: none;
    }

    .nav-ctas {
      gap: 0.75rem;
    }

    .nav-ctas .btn {
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
    }
  }
</style>
