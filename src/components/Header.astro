---
// Header Navigation Component
---

<header class="header">
  <div class="container header-container">
    <nav class="nav">
      <div class="logo">
        <a href="/">
          <span class="logo-icon">🦅</span>
          <span class="logo-text">FollowBirds</span>
        </a>
      </div>

      <ul class="nav-links">
        <li><a href="#what-is-followbirds">Features</a></li>
        <li><a href="#reports">Reports</a></li>
        <li><a href="#for-guides">For Guides</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>

      <div class="nav-ctas">
        <a href="https://followbirdsapp.web.app" class="nav-link-secondary" target="_blank">
          Open App
        </a>
        <a href="#for-guides" class="btn btn-primary btn-sm">Become a Guide</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: #fff;
    border-bottom: 1px solid #f0f0f0;
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.75rem 0;
  }

  .header-container {
    max-width: 1320px;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .logo a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.2rem;
    color: #111815;
    transition: opacity 0.2s ease;
  }

  .logo a:hover {
    opacity: 0.8;
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.5rem;
    flex: 1;
  }

  .nav-links a {
    text-decoration: none;
    color: #727272;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #559858;
  }

  .nav-ctas {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .nav-link-secondary {
    text-decoration: none;
    color: #727272;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-link-secondary:hover {
    color: #559858;
  }

  .btn-sm {
    padding: 0.65rem 1.5rem;
    font-size: 0.95rem;
  }

  @media (max-width: 1024px) {
    .nav {
      gap: 2rem;
    }

    .nav-links {
      gap: 1.5rem;
    }

    .nav-links a {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 768px) {
    .header {
      padding: 0.5rem 0;
    }

    .nav {
      gap: 1rem;
      flex-wrap: wrap;
    }

    .nav-links {
      display: none;
    }

    .logo a {
      font-size: 1rem;
    }

    .nav-ctas {
      margin-left: auto;
    }

    .nav-link-secondary {
      display: none;
    }
  }
</style>
