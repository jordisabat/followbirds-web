---
// Header Navigation Component
const base = import.meta.env.BASE_URL;
---

<header class="header">
  <div class="container header-container">
    <nav class="nav">
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-navigation">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>

      <div class="logo">
        <a href={base}>
          <img src={`${base}brand/followbirds-icon-color.svg`} alt="" aria-hidden="true" />
          <span class="logo-wordmark"><span class="logo-follow">follow</span><span class="logo-birds">birds</span></span>
        </a>
      </div>

      <ul id="site-navigation" class="nav-links">
        <li><a href="#what-is-followbirds">How it works</a></li>
        <li><a href="#for-guides">For Guides</a></li>
        <li><a href="#for-birdwatchers">For Birdwatchers</a></li>
        <li><a href="#reports">Reports</a></li>
      </ul>

      <div class="language-picker">
        <label for="language-select" class="sr-only">Language</label>
        <select id="language-select" aria-label="Language">
          <option value="en">EN</option>
          <option value="pt">PT</option>
          <option value="es">ES</option>
          <option value="ca">CA</option>
        </select>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    background: rgba(255, 255, 255, 0.84);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(35, 40, 46, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.85rem 0;
  }

  .header-container {
    max-width: 1320px;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .menu-toggle {
    display: none;
    width: 2.35rem;
    height: 2.35rem;
    padding: 0.55rem;
    border: 1px solid rgba(35, 40, 46, 0.16);
    border-radius: 0.65rem;
    background: rgba(255,255,255,0.72);
    cursor: pointer;
  }

  .menu-toggle svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--purple);
    stroke-linecap: round;
    stroke-width: 2;
  }

  .logo a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--ink);
    transition: opacity 0.2s ease;
  }

  .logo img {
    display: block;
    width: 28px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .logo-wordmark {
    display: inline-flex;
    color: #111815;
    font-weight: 400 !important;
    font-synthesis: none;
  }

  .logo-follow {
    font-weight: 400 !important;
    font-family: 'Fira Sans', sans-serif;
  }

  .logo-birds {
    font-weight: 700 !important;
    font-family: 'Fira Sans', sans-serif;
  }

  .logo a span {
    color: #111815;
  }

  .logo a:hover {
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.5rem;
    flex: 1;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--muted);
    font-weight: 500;
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--green);
  }

  .language-picker {
    display: flex;
    align-items: center;
  }

  .language-picker select {
    min-height: 2.35rem;
    padding: 0.35rem 1.9rem 0.35rem 0.7rem;
    border: 1px solid rgba(35, 40, 46, 0.2);
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.72);
    color: var(--purple);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .language-picker select:hover {
    border-color: var(--purple);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1024px) {
    .nav {
      gap: 2rem;
    }

    .nav-links {
      gap: 1.5rem;
    }

    .nav-links a {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 768px) {
    .header {
      padding: 0.5rem 0;
    }

    .nav {
      gap: 1rem;
      flex-wrap: wrap;
    }

    .menu-toggle {
      display: block;
      order: 0;
      flex-shrink: 0;
    }

    .logo {
      order: 1;
    }

    .nav-links {
      display: none;
      order: 4;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem;
      border: 1px solid var(--line);
      border-radius: 0.9rem;
      background: rgba(255,255,255,0.96);
      box-shadow: 0 14px 30px rgba(35, 40, 46, 0.1);
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-links li a {
      display: block;
      padding: 0.75rem 0.8rem;
      border-radius: 0.55rem;
    }

    .nav-links li a:hover {
      background: rgba(225, 228, 231, 0.7);
    }

    .logo a {
      font-size: 1rem;
    }

    .language-picker {
      order: 2;
      margin-left: auto;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const siteNavigation = document.querySelector<HTMLElement>('#site-navigation');

  menuToggle?.addEventListener('click', () => {
    const isOpen = siteNavigation?.classList.toggle('is-open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
  });
</script>
