---
// Tour Reports + Guide Dashboard — two-panel section
---

<section class="two-panel-section reports-dashboard-section">
  <!-- LEFT: Detailed Tour Reports -->
  <div class="panel panel-left">
    <div class="panel-inner">
      <span class="section-label">Every tour becomes a lasting record</span>
      <h2>Detailed Tour Reports</h2>
      <p class="panel-subtitle">
        Automatically generate detailed reports that participants can revisit long after the tour is finished.
      </p>

      <div class="report-card">
        <div class="report-card-header">
          <div class="report-tour-info">
            <div class="report-tour-name">Ria Formosa: Winter Birds Tour</div>
            <div class="report-meta">Guide: João · Dec 18 - Dec 2024 · 18°C</div>
          </div>
          <div class="report-stats-row">
            <div class="report-stat">
              <span class="stat-num">98</span>
              <span class="stat-lbl">Species Observed</span>
            </div>
            <div class="report-stat">
              <span class="stat-num">12</span>
              <span class="stat-lbl">Participants</span>
            </div>
          </div>
        </div>

        <div class="report-card-body">
          <div class="report-section-title">Report includes:</div>
          <div class="report-items">
            <div class="report-item">✓ Tour Name</div>
            <div class="report-item">✓ Guide</div>
            <div class="report-item">✓ Date</div>
            <div class="report-item">✓ Route</div>
            <div class="report-item">✓ Species Observed</div>
            <div class="report-item">✓ Photos</div>
            <div class="report-item">✓ Notes</div>
            <div class="report-item">✓ Participant Checklist</div>
            <div class="report-item">✓ Weather Conditions</div>
            <div class="report-item">✓ Interactive Map</div>
          </div>

          <div class="report-output">
            <div class="output-label">Output:</div>
            <div class="output-items">
              <span class="output-badge pdf">📄 PDF Export</span>
              <span class="output-badge link">🔗 Shareable Link</span>
              <span class="output-badge history">📖 FollowBirds History</span>
            </div>
          </div>
        </div>

        <div class="species-highlights">
          <div class="highlights-title">Species Highlights</div>
          <div class="highlights-list">
            <div class="highlight-item">
              <span class="bird-dot"></span>Greater Flamingo
            </div>
            <div class="highlight-item">
              <span class="bird-dot"></span>European Stonechat
            </div>
            <div class="highlight-item">
              <span class="bird-dot"></span>Black-winged Stilt
            </div>
          </div>
          <div class="flamingo-visual">🦩</div>
        </div>
      </div>

      <div class="panel-cta">
        <a href="#" class="btn btn-secondary">View Report Example</a>
      </div>
    </div>
  </div>

  <!-- DIVIDER -->
  <div class="panel-divider"></div>

  <!-- RIGHT: Guide Dashboard Overview -->
  <div class="panel panel-right">
    <div class="panel-inner">
      <span class="section-label">More than tours, a complete guide business platform</span>
      <h2>Guide Dashboard Overview</h2>
      <p class="panel-subtitle">
        FollowBirds helps guides understand their tours, clients, and birding activity.
      </p>

      <div class="dashboard-mockup">
        <div class="db-top-bar">
          <div class="db-brand">
            <span class="db-logo">🦅</span>
            <span class="db-brand-name">FollowBirds</span>
          </div>
          <div class="db-tabs">
            <span class="db-tab active">Dashboard</span>
            <span class="db-tab">Tours</span>
            <span class="db-tab">Reports</span>
          </div>
        </div>

        <div class="db-body">
          <div class="db-stats">
            <div class="db-stat-card">
              <div class="db-stat-num">128</div>
              <div class="db-stat-lbl">Tours Completed</div>
            </div>
            <div class="db-stat-card">
              <div class="db-stat-num">842</div>
              <div class="db-stat-lbl">Participants Served</div>
            </div>
            <div class="db-stat-card">
              <div class="db-stat-num">312</div>
              <div class="db-stat-lbl">Species Recorded</div>
            </div>
            <div class="db-stat-card accent">
              <div class="db-stat-num">65%</div>
              <div class="db-stat-lbl">Repeat Clients</div>
            </div>
          </div>

          <div class="db-two-col">
            <div class="db-panel">
              <div class="db-panel-title">Most Popular Tours</div>
              <div class="db-list-item">
                <span class="db-list-label">Ria Formosa</span>
                <span class="db-list-val">54x</span>
              </div>
              <div class="db-list-item">
                <span class="db-list-label">Salgedar Lagoon Tour</span>
                <span class="db-list-val">No</span>
              </div>
              <div class="db-list-item">
                <span class="db-list-label">Monchique Mountains</span>
                <span class="db-list-val">No</span>
              </div>
              <div class="db-list-item">
                <span class="db-list-label">West Coast Highlights</span>
                <span class="db-list-val">No</span>
              </div>
            </div>

            <div class="db-panel">
              <div class="db-panel-title">Observation Statistics</div>
              <div class="db-mini-chart">
                <div class="db-bar" style="height:55%"></div>
                <div class="db-bar" style="height:80%"></div>
                <div class="db-bar" style="height:40%"></div>
                <div class="db-bar" style="height:95%"></div>
                <div class="db-bar" style="height:65%"></div>
                <div class="db-bar" style="height:75%"></div>
              </div>
            </div>
          </div>

          <div class="db-activity">
            <div class="db-panel-title">Recent Tour Activity</div>
            <div class="db-activity-item">
              <div class="db-activity-dot"></div>
              <span class="db-activity-name">Ria Formosa, Spring Tour</span>
              <span class="db-activity-date">11 May 2026</span>
            </div>
            <div class="db-activity-item">
              <div class="db-activity-dot"></div>
              <span class="db-activity-name">Salgetar Lagoon Birding</span>
              <span class="db-activity-date">2 May 2026</span>
            </div>
          </div>
        </div>
      </div>

      <div class="panel-cta">
        <a href="mailto:guides@followbirds.com" class="btn btn-primary">Join the Guide Program</a>
      </div>
    </div>
  </div>
</section>

<style>
  .two-panel-section {
    display: grid;
    grid-template-columns: 1fr 4px 1fr;
    background: #FAF7EF;
  }

  .panel {
    padding: 5.5rem 0;
  }

  .panel-left .panel-inner {
    max-width: 560px;
    margin-left: auto;
    padding: 0 3rem 0 1.5rem;
  }

  .panel-right .panel-inner {
    max-width: 560px;
    margin-right: auto;
    padding: 0 1.5rem 0 3rem;
  }

  .panel-divider {
    background: #EDE8DF;
    align-self: stretch;
  }

  .panel-subtitle {
    font-size: 0.95rem;
    color: #5E6B60;
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  /* ── Report Card ── */
  .report-card {
    background: #fff;
    border: 1px solid #EDE8DF;
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.05);
  }

  .report-card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #EDE8DF;
  }

  .report-tour-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: #142016;
    margin-bottom: 0.25rem;
  }

  .report-meta {
    font-size: 0.78rem;
    color: #5E6B60;
  }

  .report-stats-row {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.75rem;
  }

  .report-stat {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 700;
    color: #2F7D32;
    line-height: 1;
  }

  .stat-lbl {
    font-size: 0.72rem;
    color: #5E6B60;
    margin-top: 0.2rem;
  }

  .report-card-body {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #EDE8DF;
  }

  .report-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #5E6B60;
    margin-bottom: 0.75rem;
  }

  .report-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.3rem 1rem;
    margin-bottom: 1rem;
  }

  .report-item {
    font-size: 0.8rem;
    color: #142016;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .report-output {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .output-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #5E6B60;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .output-items {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .output-badge {
    font-size: 0.72rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0.35rem;
    font-weight: 500;
    background: #EAF3E5;
    color: #2F7D32;
  }

  .species-highlights {
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .highlights-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #5E6B60;
    margin-bottom: 0.5rem;
  }

  .highlights-list {
    flex: 1;
  }

  .highlight-item {
    font-size: 0.8rem;
    color: #142016;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .bird-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2F7D32;
    flex-shrink: 0;
  }

  .flamingo-visual {
    font-size: 3rem;
    opacity: 0.6;
  }

  /* ── Dashboard Mockup ── */
  .dashboard-mockup {
    background: #fff;
    border: 1px solid #EDE8DF;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    margin-bottom: 1.5rem;
  }

  .db-top-bar {
    background: #142016;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .db-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .db-logo { font-size: 1rem; }

  .db-brand-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
  }

  .db-tabs {
    display: flex;
    gap: 1.25rem;
  }

  .db-tab {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.45);
    font-weight: 500;
    cursor: default;
  }

  .db-tab.active {
    color: #fff;
    border-bottom: 2px solid #2F7D32;
    padding-bottom: 0.15rem;
  }

  .db-body {
    padding: 1.25rem;
  }

  .db-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .db-stat-card {
    background: #FAF7EF;
    border-radius: 0.5rem;
    padding: 0.75rem;
    border: 1px solid #EDE8DF;
    text-align: center;
  }

  .db-stat-card.accent {
    background: #EAF3E5;
    border-color: #C7E0C8;
  }

  .db-stat-num {
    font-size: 1.3rem;
    font-weight: 700;
    color: #2F7D32;
    line-height: 1.2;
  }

  .db-stat-lbl {
    font-size: 0.65rem;
    color: #5E6B60;
    margin-top: 0.2rem;
    line-height: 1.2;
  }

  .db-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .db-panel {
    background: #FAF7EF;
    border-radius: 0.5rem;
    padding: 0.85rem;
    border: 1px solid #EDE8DF;
  }

  .db-panel-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #5E6B60;
    margin-bottom: 0.6rem;
  }

  .db-list-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #142016;
    margin-bottom: 0.3rem;
  }

  .db-list-val {
    color: #2F7D32;
    font-weight: 600;
  }

  .db-mini-chart {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 50px;
  }

  .db-bar {
    flex: 1;
    background: #2F7D32;
    border-radius: 2px 2px 0 0;
    opacity: 0.7;
  }

  .db-activity {
    background: #FAF7EF;
    border-radius: 0.5rem;
    padding: 0.85rem;
    border: 1px solid #EDE8DF;
  }

  .db-activity-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .db-activity-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2F7D32;
    flex-shrink: 0;
  }

  .db-activity-name {
    flex: 1;
    font-size: 0.72rem;
    color: #142016;
  }

  .db-activity-date {
    font-size: 0.65rem;
    color: #5E6B60;
  }

  .panel-cta {
    margin-top: 0.5rem;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .two-panel-section {
      grid-template-columns: 1fr;
    }

    .panel-divider {
      display: none;
    }

    .panel {
      padding: 4rem 0;
      border-bottom: 1px solid #EDE8DF;
    }

    .panel:last-child {
      border-bottom: none;
    }

    .panel-left .panel-inner,
    .panel-right .panel-inner {
      max-width: 680px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .db-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .report-items {
      grid-template-columns: 1fr;
    }
  }
</style>
