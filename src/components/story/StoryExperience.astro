---
import type { StoryStepContent } from '../../content/story.types';
import StoryStep from './StoryStep.astro';
import StoryDevice from './StoryDevice.astro';

interface Props {
  steps: StoryStepContent[];
}
const { steps } = Astro.props;
---
<div class="story-experience">
  <div class="story-steps-panel">
    {steps.map(step => <StoryStep step={step} />)}
  </div>
  <div class="story-device-panel">
    <StoryDevice steps={steps} />
  </div>
</div>
