---
// Example Tour Experience Section
---

<section class="example-tour-experience section">
  <div class="container">
    <h2>A shared tour experience, live as it happens.</h2>
    <p class="section-subtitle">
      The guide records observations once. Participants receive the shared list immediately.
    </p>

    <div class="tour-experience-grid">
      <div class="experience-card timeline-card">
        <h3>Live Timeline</h3>
        <div class="timeline">
          <div class="timeline-item">
            <span class="time">08:42</span>
            <span class="species">🦅 Booted Eagle</span>
          </div>
          <div class="timeline-item">
            <span class="time">09:10</span>
            <span class="species">🐦 Kentish Plover</span>
          </div>
          <div class="timeline-item">
            <span class="time">09:45</span>
            <span class="species">🦆 Greater Flamingo</span>
          </div>
          <div class="timeline-item">
            <span class="time">10:20</span>
            <span class="species">🐝 European Bee-eater</span>
          </div>
        </div>
      </div>

      <div class="experience-card checklist-card">
        <h3>Shared Checklist</h3>
        <div class="checklist">
          <div class="checklist-item">
            <input type="checkbox" id="eagle" checked />
            <label for="eagle">Booted Eagle</label>
            <span class="mark">📸 You saw it</span>
          </div>
          <div class="checklist-item">
            <input type="checkbox" id="plover" checked />
            <label for="plover">Kentish Plover</label>
            <span class="mark">✓ You saw it</span>
          </div>
          <div class="checklist-item">
            <input type="checkbox" id="flamingo" checked />
            <label for="flamingo">Greater Flamingo</label>
            <span class="mark">⭐ Lifer!</span>
          </div>
          <div class="checklist-item">
            <input type="checkbox" id="beeater" checked />
            <label for="beeater">European Bee-eater</label>
          </div>
        </div>
      </div>

      <div class="experience-card info-card">
        <h3>Tour Details</h3>
        <div class="tour-info">
          <div class="info-row">
            <span class="label">📍 Location:</span>
            <span>Ria Formosa, Algarve</span>
          </div>
          <div class="info-row">
            <span class="label">👤 Guide:</span>
            <span>João Silva</span>
          </div>
          <div class="info-row">
            <span class="label">👥 Participants:</span>
            <span>8 birdwatchers</span>
          </div>
          <div class="info-row">
            <span class="label">🕐 Duration:</span>
            <span>3 hours</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .example-tour-experience {
    background: linear-gradient(135deg, #faf9f7 0%, #f0ede8 100%);
  }

  .example-tour-experience h2 {
    text-align: center;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    text-align: center;
    font-size: 1.125rem;
    color: #666;
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .tour-experience-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .experience-card {
    background: #fff;
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid #e0e0e0;
  }

  .experience-card h3 {
    margin-bottom: 1.5rem;
    color: #1b5e20;
  }

  .timeline-item {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .time {
    font-weight: 700;
    color: #1b5e20;
    min-width: 60px;
  }

  .species {
    color: #333;
  }

  .checklist-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    position: relative;
  }

  .checklist-item input[type="checkbox"] {
    cursor: pointer;
    width: 18px;
    height: 18px;
  }

  .checklist-item label {
    cursor: pointer;
    flex: 1;
    color: #333;
  }

  .checklist-item .mark {
    font-size: 0.85rem;
    color: #1b5e20;
    font-weight: 500;
  }

  .tour-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-row .label {
    font-weight: 600;
    color: #1b5e20;
    font-size: 0.95rem;
  }

  .info-row span:not(.label) {
    color: #666;
  }

  @media (max-width: 768px) {
    .tour-experience-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
