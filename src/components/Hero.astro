---
// Hero Section Component
const base = import.meta.env.BASE_URL;
---

<section class="hero section" style={`--hero-image: url("${base}hero-birdwatching-portugal.png")`}>
  <div class="hero-background"></div>
  <div class="hero-overlay"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <span class="eyebrow">Launching with birding guides</span>
      <h1>Run better birding tours. <span>Give every guest a story to keep.</span></h1>
      <p class="hero-subtitle">
        followbirds is building a guide workspace for creating tours, sharing sightings, and sending a polished follow-up report.
      </p>

      <div class="hero-ctas">
        <a href="mailto:guides@followbirds.com?subject=Founding%20guide%20program" class="btn btn-primary btn-lg">Join the founding guide program</a>
        <a href="#for-birdwatchers" class="hero-guest-link">See the guest experience <span aria-hidden="true">→</span></a>
      </div>

      <div class="store-badges" aria-label="App store links">
        <a class="store-badge" href="https://play.google.com/store/apps/details?id=com.followbirds.android" target="_blank" rel="noreferrer">Google Play</a>
        <a class="store-badge store-badge-web" href="https://followbirds.com/app" target="_blank" rel="noreferrer">Web App</a>
        <span class="store-badge store-badge-disabled" role="status" aria-label="App Store, coming soon">
          <span> App Store</span>
          <small>Coming soon</small>
        </span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-frame">
        <img src={`${base}hero-birdwatching-portugal.png`} alt="Birdwatchers using binoculars and spotting scopes on the Portuguese coast" loading="eager" />
        <div class="visual-card visual-card-top">
          <span class="card-label">Guide workspace preview</span>
          <strong>One place for every tour</strong>
          <p>Tour setup, shared sightings, and guest follow-up</p>
        </div>
        <div class="visual-card visual-card-bottom">
          <span class="card-label">Built with founding guides</span>
          <strong>Shape what comes next</strong>
          <p>Early access, direct input, and priority support</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 4rem 0 3.5rem;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.88) 0, rgba(255,255,255,0.2) 36%, transparent 62%),
      linear-gradient(110deg, rgba(255,255,255,0.97) 0%, rgba(243,244,245,0.92) 48%, rgba(243,244,245,0.5) 64%, rgba(243,244,245,0.15) 100%),
      var(--hero-image) center/cover no-repeat;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.16), rgba(241,242,243,0.42));
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 2rem;
    align-items: center;
  }

  .hero-content {
    padding: 1rem 0 1rem 0.25rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: rgba(255,255,255,0.78);
    color: var(--green);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid rgba(35,40,46,0.12);
    margin-bottom: 1.4rem;
  }

  .hero h1 {
    max-width: 12ch;
    font-size: clamp(2.35rem, 4.4vw, 4rem);
    line-height: 1.08;
    margin-bottom: 1.2rem;
  }

  .hero h1 span {
    color: var(--green);
  }

  .hero-subtitle {
    font-size: 1.06rem;
    color: var(--muted);
    margin-bottom: 2rem;
    line-height: 1.75;
    max-width: 40rem;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .btn-ghost {
    background: rgba(255,255,255,0.58);
    color: var(--ink);
    border: 1px solid rgba(27, 27, 22, 0.08);
    box-shadow: none;
  }

  .btn-ghost:hover {
    background: #fff;
  }

  .hero-guest-link {
    display: inline-flex;
    flex-basis: 100%;
    align-items: center;
    gap: 0.4rem;
    color: var(--purple);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-guest-link span {
    color: var(--green-deep);
    transition: transform 0.2s ease;
  }

  .hero-guest-link:hover span {
    transform: translateX(0.2rem);
  }

  .store-badges {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .store-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 128px;
    padding: 0.72rem 1rem;
    border-radius: 0.75rem;
    background: rgba(12, 12, 12, 0.96);
    color: #fff;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    box-shadow: 0 12px 28px rgba(0,0,0,0.12);
  }

  .store-badge-disabled {
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 1.1rem;
    background: rgba(102, 104, 95, 0.68);
    color: rgba(255, 255, 255, 0.9);
    cursor: not-allowed;
    box-shadow: none;
  }

  .store-badge-disabled small {
    position: absolute;
    right: 0.5rem;
    bottom: 0.32rem;
    left: 0.5rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .store-badge-web {
    background: var(--green-deep);
  }

  .hero-visual {
    display: flex;
    justify-content: flex-end;
  }

  .visual-frame {
    position: relative;
    width: min(100%, 540px);
    aspect-ratio: 0.92;
    overflow: visible;
  }

  .visual-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    pointer-events: none;
  }

  .visual-frame::after {
    display: none;
  }

  .visual-card {
    position: absolute;
    max-width: 220px;
    border-radius: 1rem;
    padding: 0.95rem 1rem;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(35,40,46,0.12);
    box-shadow: 0 12px 30px rgba(28, 33, 39, 0.12);
    z-index: 2;
  }

  .visual-card strong {
    display: block;
    color: var(--ink);
    font-size: 0.98rem;
    margin-bottom: 0.35rem;
  }

  .visual-card p,
  .card-label {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .card-label {
    display: inline-block;
    margin-bottom: 0.35rem;
    color: var(--green);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .visual-card-top {
    top: 1rem;
    left: 1rem;
  }

  .visual-card-bottom {
    right: 1rem;
    bottom: 1rem;
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 0 2.75rem;
    }

    .hero-content {
      padding-right: 0;
    }

    .hero h1 {
      max-width: none;
      font-size: clamp(2.25rem, 10vw, 3.2rem);
    }

    .hero-ctas {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-ctas .btn {
      width: fit-content;
      max-width: 100%;
      text-align: left;
    }

    .store-badges {
      flex-wrap: nowrap;
      gap: 0.55rem;
    }

    .store-badge {
      width: auto;
      min-width: 0;
      padding: 0.65rem 0.8rem;
      font-size: 0.78rem;
      white-space: nowrap;
    }

    .visual-frame {
      width: 100%;
      aspect-ratio: 0.88;
    }

    .visual-card {
      max-width: 180px;
    }
  }

  @media (max-width: 360px) {
    .store-badges {
      flex-wrap: wrap;
    }
  }
</style>
