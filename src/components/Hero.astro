---
// Hero Section Component
---

<section class="hero section">
  <div class="container">
    <div class="hero-content">
      <h1>Birdwatching tours, live checklists and beautiful reports.</h1>
      <p class="hero-subtitle">
        Build seamless tour experiences. Share live observations. Generate professional reports your clients will treasure.
      </p>

      <div class="hero-ctas">
        <a href="#guide-program" class="btn btn-primary btn-lg">Become a Guide</a>
        <a href="#tour-report" class="btn btn-secondary btn-lg">See Example Report</a>
        <a href="https://followbirdsapp.web.app" class="btn btn-tertiary" target="_blank">
          Open Web App →
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <!-- TODO: Add hero image mockup - birding app screenshot or Algarve nature scene -->
      <div class="placeholder-mockup">
        <div class="mockup-content">
          <div class="mockup-header">
            <div class="mockup-circle"></div>
            <div class="mockup-circle"></div>
            <div class="mockup-circle"></div>
          </div>
          <div class="mockup-line"></div>
          <div class="mockup-line short"></div>
          <div class="mockup-list">
            <div class="mockup-item">🦅 Booted Eagle</div>
            <div class="mockup-item">🦆 Greater Flamingo</div>
            <div class="mockup-item">🦅 European Bee-eater</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #FAF7EF 0%, #EAF3E5 100%);
    padding: 6rem 0 5rem;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    flex: 1;
  }

  .hero h1 {
    color: #142016;
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #5E6B60;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.05rem;
  }

  .btn-tertiary {
    background: none;
    color: #2F7D32;
    border: none;
    font-weight: 600;
    padding: 0;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .btn-tertiary:hover {
    color: #1b5e20;
  }

  .hero-visual {
    flex: 1;
  }

  .placeholder-mockup {
    background: linear-gradient(135deg, #F7F3E8 0%, #fff 100%);
    border-radius: 1.5rem;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #E8DFD3;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .mockup-content {
    width: 85%;
    padding: 1.5rem;
  }

  .mockup-header {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .mockup-circle {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #ccc;
  }

  .mockup-line {
    height: 0.75rem;
    background: #e0e0e0;
    border-radius: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .mockup-line.short {
    width: 60%;
    margin-bottom: 1.5rem;
  }

  .mockup-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mockup-item {
    background: #e8f5e9;
    color: #2F7D32;
    padding: 0.5rem 0.75rem;
    border-radius: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 968px) {
    .hero .container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .placeholder-mockup {
      aspect-ratio: 16/9;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 3.5rem;
    }

    .hero .container {
      grid-template-columns: 1fr;
    }

    .hero-ctas {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-ctas .btn {
      width: 100%;
      text-align: center;
    }

    .btn-tertiary {
      padding: 0.75rem 1rem;
      width: 100%;
      text-align: center;
    }

    .placeholder-mockup {
      aspect-ratio: 16/9;
    }
  }
</style>
