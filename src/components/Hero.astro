---
// Hero Section Component
---

<section class="hero section">
  <!-- Background image -->
  <div class="hero-background"></div>
  
  <div class="hero-overlay"></div>

  <p class="hero-photo-credit">
    Photo by <a href="https://unsplash.com/@_nnaro_?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener">Diego Gennaro</a> on <a href="https://unsplash.com/photos/photography-of-seashore-during-daytime-cmYjQ30PbWk?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener">Unsplash</a>
  </p>

  <div class="container hero-container">
    <div class="hero-content">
      <h1>Run better birdwatching tours.<br/>Give every guest a beautiful report.</h1>
      <p class="hero-subtitle">
        FollowBirds helps Algarve guides share live sightings, build tour checklists and generate automatic reports for every participant.
      </p>

      <div class="hero-ctas">
        <a href="mailto:guides@followbirds.com" class="btn btn-primary btn-lg">Become a Guide</a>
        <a href="#reports" class="btn btn-secondary btn-lg">See Example Report</a>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 3rem 0 4rem;
    min-height: 700px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('/hero-background-algarve.jpg') center/cover no-repeat;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      105deg,
      rgba(47, 23, 55, 0.72) 0%,
      rgba(47, 23, 55, 0.45) 55%,
      rgba(47, 23, 55, 0.2) 100%
    );
    z-index: 1;
  }

  .hero-photo-credit {
    position: absolute;
    bottom: 0.75rem;
    right: 1rem;
    z-index: 10;
    font-size: 0.68rem;
    color: rgba(255,255,255,0.45);
    margin: 0;
    line-height: 1;
  }

  .hero-photo-credit a {
    color: rgba(255,255,255,0.45);
    text-decoration: none;
  }

  .hero-photo-credit a:hover {
    color: rgba(255,255,255,0.75);
    text-decoration: underline;
  }

  .hero-container {
    position: relative;
    z-index: 10;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-content {
    padding: 0 1.5rem;
  }

  .hero h1 {
    color: #fff;
    margin-bottom: 1.5rem;
    font-size: 3.2rem;
    line-height: 1.15;
    font-weight: 400;
    text-shadow: 0 2px 16px rgba(0,0,0,0.3);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: rgba(255,255,255,0.88);
    margin-bottom: 2rem;
    line-height: 1.7;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    text-shadow: 0 1px 8px rgba(0,0,0,0.2);
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  /* Override secondary button for hero (white outline on dark bg) */
  .hero-ctas .btn-secondary {
    background: rgba(255,255,255,0.12);
    color: #fff;
    border-color: rgba(255,255,255,0.7);
  }

  .hero-ctas .btn-secondary:hover {
    background: rgba(255,255,255,0.22);
    border-color: #fff;
    color: #fff;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 2rem 0 3rem;
    }

    .hero h1 {
      font-size: 1.75rem;
      margin-bottom: 1rem;
    }

    .hero-subtitle {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .hero-ctas {
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .hero-ctas .btn {
      width: 100%;
    }
  }
</style>
