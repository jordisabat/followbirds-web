---
// Hero Section Component
---

<section class="hero section">
  <div class="container">
    <div class="hero-content">
      <h1>Run better birdwatching tours.<br/>Give every guest a beautiful report.</h1>
      <p class="hero-subtitle">
        FollowBirds helps Algarve guides share live sightings, build tour checklists and generate automatic reports for every participant.
      </p>

      <div class="hero-ctas">
        <a href="#guide-program" class="btn btn-primary btn-lg">Become a Guide</a>
        <a href="#reports" class="btn btn-secondary btn-lg">See Example Report</a>
        <a href="https://followbirdsapp.web.app" class="btn btn-tertiary" target="_blank">
          Open App →
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <!-- TODO: Replace with real report screenshot -->
      <div class="report-preview">
        <div class="report-header-mock">
          <div class="report-title">Ria Formosa Tour</div>
          <div class="report-meta">João Silva • 8 participants</div>
        </div>

        <div class="report-section-mock">
          <div class="report-label">Species Sighted</div>
          <div class="species-chips">
            <span class="chip">🦅 Booted Eagle</span>
            <span class="chip">🦆 Greater Flamingo</span>
            <span class="chip">🐝 Bee-eater</span>
            <span class="chip">🦅 Audouin's Gull</span>
          </div>
        </div>

        <div class="report-section-mock">
          <div class="report-label">Timeline</div>
          <div class="timeline-mock">
            <div class="timeline-entry">
              <span class="time">08:42</span>
              <span class="species">Booted Eagle</span>
            </div>
            <div class="timeline-entry">
              <span class="time">09:45</span>
              <span class="species">Greater Flamingo</span>
            </div>
            <div class="timeline-entry">
              <span class="time">10:20</span>
              <span class="species">European Bee-eater</span>
            </div>
          </div>
        </div>

        <div class="report-footer-mock">
          📊 Web Report • 📄 PDF • 🔗 Shareable
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #FAF7EF 0%, #EAF3E5 100%);
    padding: 6rem 0 5rem;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    flex: 1;
  }

  .hero h1 {
    color: #142016;
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #5E6B60;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.05rem;
  }

  .btn-tertiary {
    background: none;
    color: #2F7D32;
    border: none;
    font-weight: 600;
    padding: 0;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .btn-tertiary:hover {
    color: #1b5e20;
  }

  .hero-visual {
    flex: 1;
  }

  .report-preview {
    background: linear-gradient(135deg, #FFFFFF 0%, #F9F7F3 100%);
    border-radius: 1.25rem;
    border: 1px solid #E8DFD3;
    padding: 2rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .report-header-mock {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid #2F7D32;
  }

  .report-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #142016;
    margin-bottom: 0.25rem;
  }

  .report-meta {
    font-size: 0.85rem;
    color: #999;
  }

  .report-section-mock {
    margin-bottom: 1.5rem;
  }

  .report-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #2F7D32;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.75rem;
  }

  .species-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    background: #EAF3E5;
    color: #2F7D32;
    padding: 0.45rem 0.85rem;
    border-radius: 0.55rem;
    font-size: 0.82rem;
    font-weight: 500;
    display: inline-block;
  }

  .timeline-mock {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .timeline-entry {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0.85rem;
    background: #FAF7EF;
    border-left: 3px solid #2F7D32;
    border-radius: 0.4rem;
    font-size: 0.85rem;
  }

  .time {
    font-weight: 700;
    color: #2F7D32;
    min-width: 50px;
  }

  .species {
    color: #142016;
  }

  .report-footer-mock {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid #E8DFD3;
    font-size: 0.85rem;
    color: #5E6B60;
    font-weight: 500;
  }

  @media (max-width: 968px) {
    .hero .container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 3.5rem;
    }

    .hero .container {
      grid-template-columns: 1fr;
    }

    .hero-ctas {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-ctas .btn {
      width: 100%;
      text-align: center;
    }

    .btn-tertiary {
      padding: 0.75rem 1rem;
      width: 100%;
      text-align: center;
    }

    .report-preview {
      padding: 1.5rem;
    }

    .report-header-mock {
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
    }
  }
</style>
