---
// Hero Section Component
---

<section class="hero section">
  <div class="container">
    <div class="hero-content">
      <h1>Birdwatching tours, live checklists and beautiful reports.</h1>
      <p class="hero-subtitle">
        Create tours, share live sightings, build checklists and generate beautiful reports automatically.
      </p>

      <div class="hero-ctas">
        <a href="#guide-program" class="btn btn-primary">Become a Guide</a>
        <a href="https://app.followbirds.com" class="btn btn-secondary" target="_blank">
          Open Web App
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <!-- TODO: Add hero image - bird/tour/Algarve experience -->
      <div class="placeholder-image">
        <span>Hero Image Placeholder</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #faf9f7 0%, #f0ede8 100%);
    padding: 5rem 0;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-content {
    flex: 1;
  }

  .hero h1 {
    color: #1a1a1a;
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: #555;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-visual {
    flex: 1;
  }

  .placeholder-image {
    background: linear-gradient(135deg, #d4af6a 0%, #9b7e4d 100%);
    border-radius: 1rem;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero .container {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 3rem 0;
    }

    .placeholder-image {
      aspect-ratio: 16/9;
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
