---
// Final CTA Section
---

<section class="final-cta">
  <div class="cta-background"></div>
  <div class="cta-overlay"></div>
  <div class="container cta-inner">
    <h2>Become one of the first<br/>FollowBirds guides in Algarve</h2>
    <p class="cta-subtitle">For private tours, group walks, hotel experiences and birding holidays.</p>
    <div class="cta-buttons">
      <a href="mailto:guides@followbirds.com" class="btn btn-white">Join the Guide Program</a>
      <a href="#reports" class="btn btn-outline-white">See Example Report</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    padding: 7rem 0;
    text-align: center;
    overflow: hidden;
  }

  .cta-background {
    position: absolute;
    inset: 0;
    background: url('/cta-flamingos.jpg') center/cover no-repeat,
                linear-gradient(180deg, #2F1737 0%, #1B5E20 100%);
    z-index: 0;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(47, 23, 55, 0.65);
    z-index: 1;
  }

  .cta-inner {
    position: relative;
    z-index: 2;
  }

  .final-cta h2 {
    color: #fff;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }

  .cta-subtitle {
    color: rgba(255,255,255,0.78);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
    text-shadow: 0 1px 6px rgba(0,0,0,0.2);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    min-width: 180px;
  }

  .btn-white {
    background: #fff;
    color: #559858;
    font-weight: 700;
    border-radius: 0.65rem;
    padding: 0.9rem 2rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-white:hover {
    background: #F1F7F2;
    transform: translateY(-2px);
  }

  .btn-outline-white {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.7);
    font-weight: 600;
    border-radius: 0.65rem;
    padding: 0.9rem 2rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-outline-white:hover {
    background: rgba(255,255,255,0.12);
    border-color: #fff;
  }

  @media (max-width: 768px) {
    .final-cta {
      padding: 5rem 0;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-buttons .btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
