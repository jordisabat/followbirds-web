---
// Final CTA Section
---

<section class="final-cta">
  <div class="cta-background"></div>
  <div class="cta-overlay"></div>
  <div class="container cta-inner">
    <h2>Ready for Your Next<br/>Birdwatching Adventure?</h2>
    <div class="cta-buttons">
      <a href="https://followbirdsapp.web.app" class="btn btn-white" target="_blank">Open App</a>
      <a href="#guide-program" class="btn btn-outline-white">Become a Guide</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    padding: 7rem 0;
    text-align: center;
    overflow: hidden;
  }

  .cta-background {
    position: absolute;
    inset: 0;
    background: url('/cta-flamingos.jpg') center/cover no-repeat,
                linear-gradient(180deg, #1b5e20 0%, #0d3d0e 100%);
    z-index: 0;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(20, 32, 22, 0.65);
    z-index: 1;
  }

  .cta-inner {
    position: relative;
    z-index: 2;
  }

  .final-cta h2 {
    color: #fff;
    margin-bottom: 2.5rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    min-width: 180px;
  }

  .btn-white {
    background: #fff;
    color: #2F7D32;
    font-weight: 700;
    border-radius: 0.65rem;
    padding: 0.9rem 2rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-white:hover {
    background: #F0F9F0;
    transform: translateY(-2px);
  }

  .btn-outline-white {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.7);
    font-weight: 600;
    border-radius: 0.65rem;
    padding: 0.9rem 2rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-outline-white:hover {
    background: rgba(255,255,255,0.12);
    border-color: #fff;
  }

  @media (max-width: 768px) {
    .final-cta {
      padding: 5rem 0;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-buttons .btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
