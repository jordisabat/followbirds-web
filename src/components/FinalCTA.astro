---
// Final CTA Section
---

<section class="final-cta section">
  <div class="container">
    <div class="cta-content">
      <h2>Ready to transform your tours?</h2>
      <p>
        Join the early guide program and start delivering beautiful reports to your clients today. Your birding will never be the same.
      </p>

      <div class="cta-buttons">
        <a href="#guide-program" class="btn btn-primary">Become a Guide</a>
        <a href="https://followbirdsapp.web.app" class="btn btn-secondary-light" target="_blank">
          Open Web App
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: linear-gradient(135deg, #2F7D32 0%, #1b5e20 100%);
    color: #fff;
    text-align: center;
  }

  .final-cta h2 {
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .cta-content p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    min-width: 200px;
  }

  .btn-secondary-light {
    background-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    border: 2px solid #fff;
    transition: all 0.2s ease;
  }

  .btn-secondary-light:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .final-cta .btn-primary {
    background-color: #fff;
    color: #2F7D32;
  }

  .final-cta .btn-primary:hover {
    background-color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 768px) {
    .cta-buttons {
      flex-direction: column;
    }

    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>
