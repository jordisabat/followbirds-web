---
// Final CTA Section
---

<section class="final-cta section">
  <div class="container">
    <div class="cta-content">
      <h2>Start building better birdwatching experiences.</h2>
      <p>
        FollowBirds helps guides run memorable tours and helps birdwatchers keep every observation.
      </p>

      <div class="cta-buttons">
        <a href="#guide-program" class="btn btn-primary">Become a Guide</a>
        <a href="https://app.followbirds.com" class="btn btn-secondary-light" target="_blank">
          Open Web App
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: linear-gradient(135deg, #1b5e20 0%, #0d3616 100%);
    color: #fff;
    text-align: center;
  }

  .final-cta h2 {
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .cta-content p {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    min-width: 200px;
  }

  .btn-secondary-light {
    background-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    border: 2px solid #fff;
  }

  .btn-secondary-light:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .final-cta .btn-primary {
    background-color: #fff;
    color: #1b5e20;
  }

  .final-cta .btn-primary:hover {
    background-color: #f0f0f0;
  }

  @media (max-width: 768px) {
    .cta-buttons {
      flex-direction: column;
    }

    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>
