---
// Final CTA Section
---

<section class="final-cta">
  <div class="cta-background"></div>
  <div class="cta-overlay"></div>
  <div class="container cta-inner">
    <h2>Help shape the first<br/>followbirds guide workspace.</h2>
    <p class="cta-subtitle">Join the founding guide program and help us build around the way you really run tours.</p>
    <div class="cta-buttons">
      <a href="mailto:guides@followbirds.com?subject=Founding%20guide%20program" class="btn btn-white">Apply as a founding guide</a>
      <a href="https://followbirds.com/app" class="btn btn-outline-white" target="_blank" rel="noreferrer">Open the current app</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    padding: 7rem 0;
    text-align: center;
    overflow: hidden;
  }

  .cta-background {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(255,255,255,0.92), transparent 34%),
      linear-gradient(135deg, #e4e7e9 0%, #f8f8f8 100%);
    z-index: 0;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.18);
    z-index: 1;
  }

  .cta-inner {
    position: relative;
    z-index: 2;
  }

  .final-cta h2 {
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .cta-subtitle {
    color: var(--muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    min-width: 180px;
  }

  .btn-white {
    background: var(--green-deep);
    color: #fff;
    font-weight: 700;
    border-radius: 0.65rem;
    padding: 0.9rem 2rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-white:hover {
    background: var(--green);
    transform: translateY(-2px);
  }

  .btn-outline-white {
    background: transparent;
    color: var(--purple);
    border: 2px solid rgba(47,23,55,0.28);
    font-weight: 600;
    border-radius: 0.65rem;
    padding: 0.9rem 2rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-outline-white:hover {
    background: rgba(255,255,255,0.7);
    border-color: var(--purple);
  }

  @media (max-width: 768px) {
    .final-cta {
      padding: 5rem 0;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-buttons .btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
