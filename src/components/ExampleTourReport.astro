---
// Reports Section
---

<section id="reports" class="reports section">
  <div class="container">
    <div class="reports-grid">
      <div class="reports-content">
        <h2>Every Tour Becomes a<br/>Lasting Record</h2>
        <p class="reports-subtitle">
          Automatically generate detailed tour reports with species observed, photos, route data, and participant information.
        </p>

        <div class="report-features">
          <div class="feature-list">
            <div class="feature">✓ Tour name and date</div>
            <div class="feature">✓ Species checklist</div>
            <div class="feature">✓ Bird sighting details</div>
            <div class="feature">✓ Route information</div>
            <div class="feature">✓ Participant list</div>
            <div class="feature">✓ Participant feedback</div>
            <div class="feature">✓ Weather conditions</div>
          </div>
        </div>

        <div class="report-cta">
          <a href="#" class="btn btn-secondary">View Report Example</a>
        </div>
      </div>

      <div class="reports-visual">
        <div class="report-mockup">
          <div class="tour-map" style="background: linear-gradient(135deg, #C7E0C8 0%, #A6D5A3 100%); height: 200px; border-radius: 0.75rem; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center; color: #559858; font-size: 2rem;">🗺️</div>
          
          <div class="report-frame">
            <div class="report-header-mock">
              <h3>Rio Formosa – Winter Birds Tour</h3>
              <p class="report-meta">Report Includes:</p>
            </div>

            <div class="report-section-mock">
              <div class="section-item">
                <span class="report-label">📋 Species Observed</span>
                <span class="report-value">28</span>
              </div>
              <div class="section-item">
                <span class="report-label">📷 Photos Attached</span>
                <span class="report-value">42</span>
              </div>
              <div class="section-item">
                <span class="report-label">👥 Participants</span>
                <span class="report-value">8</span>
              </div>
              <div class="section-item">
                <span class="report-label">⭐ Average Rating</span>
                <span class="report-value">4.9/5</span>
              </div>
            </div>

            <div class="report-footer-mock">
              📄 PDF • 🔗 Web Link • 📧 Email
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reports {
    background-color: #fff;
    padding: 5.5rem 0;
  }

  .reports-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .reports-content h2 {
    font-size: 2rem;
    color: #111815;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .reports-subtitle {
    font-size: 1.05rem;
    color: #727272;
    margin-bottom: 2.5rem;
    line-height: 1.6;
    max-width: 500px;
  }

  .report-features {
    margin-bottom: 2.5rem;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature {
    color: #727272;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .report-cta {
    text-align: left;
  }

  .reports-visual {
    display: flex;
    justify-content: flex-end;
  }

  .report-mockup {
    width: 100%;
    max-width: 400px;
  }

  .tour-map {
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .report-frame {
    background: #F4EFF6;
    border: 1px solid #E8DFD3;
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .report-header-mock {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid #559858;
  }

  .report-header-mock h3 {
    color: #559858;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    line-height: 1.3;
  }

  .report-meta {
    font-size: 0.8rem;
    color: #999;
    margin: 0;
  }

  .report-section-mock {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: #fff;
    border-radius: 0.5rem;
    border: 1px solid #E8DFD3;
  }

  .report-label {
    font-size: 0.85rem;
    color: #727272;
    font-weight: 500;
  }

  .report-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #559858;
  }

  .report-footer-mock {
    text-align: center;
    padding-top: 0.75rem;
    border-top: 1px solid #E8DFD3;
    font-size: 0.75rem;
    color: #727272;
  }

  @media (max-width: 1024px) {
    .reports-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .reports-visual {
      justify-content: center;
    }

    .report-mockup {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .reports {
      padding: 4rem 0;
    }

    .reports-grid {
      gap: 2rem;
    }

    .reports-content h2 {
      font-size: 1.5rem;
    }

    .reports-subtitle {
      font-size: 1rem;
    }

    .feature-list {
      gap: 0.6rem;
    }

    .feature {
      font-size: 0.9rem;
    }
  }
</style>
