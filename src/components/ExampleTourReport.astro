---
// Example Tour Report Section
---

<section id="tour-report" class="example-tour-report section">
  <div class="container">
    <h2>Every tour becomes a beautiful report.</h2>
    <p class="section-subtitle">
      After each tour, FollowBirds turns observations, photos and route details into a shareable memory for every participant.
    </p>

    <div class="report-grid">
      <div class="report-preview">
        <div class="report-mock">
          <div class="report-header">
            <h3>🦅 Ria Formosa Tour Report</h3>
            <p class="report-meta">May 15, 2024 • Guide: João Silva • 8 participants</p>
          </div>

          <div class="report-section">
            <h4>Species Observed</h4>
            <div class="species-list">
              <span class="species-badge">Booted Eagle</span>
              <span class="species-badge">Kentish Plover</span>
              <span class="species-badge">Greater Flamingo</span>
              <span class="species-badge">European Bee-eater</span>
              <span class="species-badge">Audouin's Gull</span>
              <span class="species-badge">Marsh Harrier</span>
            </div>
          </div>

          <div class="report-section">
            <h4>Tour Timeline</h4>
            <div class="report-timeline">
              <div class="report-observation">
                <span class="obs-time">08:42</span>
                <span class="obs-species">Booted Eagle</span>
                <span class="obs-note">Great views at reference point 1</span>
              </div>
              <div class="report-observation">
                <span class="obs-time">09:10</span>
                <span class="obs-species">Kentish Plover</span>
                <span class="obs-note">Family of 4 by the shore</span>
              </div>
              <div class="report-observation">
                <span class="obs-time">10:20</span>
                <span class="obs-species">European Bee-eater</span>
                <span class="obs-note">Stunning colors and behavior</span>
              </div>
            </div>
          </div>

          <div class="report-outputs">
            <p>📄 Generate: <strong>Web Report</strong> • <strong>PDF</strong> • <strong>Shareable Link</strong></p>
          </div>
        </div>
      </div>

      <div class="report-features">
        <h3>Report Includes</h3>
        <ul class="report-checklist">
          <li>✓ Tour information & guide details</li>
          <li>✓ Complete participant list</li>
          <li>✓ Species timeline with observations</li>
          <li>✓ Photos and notes</li>
          <li>✓ Route map and locations</li>
          <li>✓ Shareable web link</li>
          <li>✓ PDF download for offline access</li>
          <li>✓ Personal archive for birdwatchers</li>
        </ul>

        <div class="report-cta">
          <a href="#" class="btn btn-secondary" title="TODO: Link to example report">
            View Example Report
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .example-tour-report {
    background-color: #FAF7EF;
  }

  .example-tour-report h2 {
    text-align: center;
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    text-align: center;
    font-size: 1.1rem;
    color: #5E6B60;
    margin-bottom: 3.5rem;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .report-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .report-mock {
    background: #FFFFFF;
    border: 1px solid #E8DFD3;
    border-radius: 0.85rem;
    padding: 2rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .report-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #2F7D32;
  }

  .report-header h3 {
    color: #2F7D32;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .report-meta {
    font-size: 0.8rem;
    color: #999;
  }

  .report-section {
    margin-bottom: 1.5rem;
  }

  .report-section h4 {
    color: #142016;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .species-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .species-badge {
    background: #EAF3E5;
    color: #2F7D32;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .report-timeline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .report-observation {
    display: flex;
    gap: 1rem;
    padding: 0.75rem;
    background: #FAF7EF;
    border-radius: 0.5rem;
    border-left: 3px solid #2F7D32;
  }

  .obs-time {
    font-weight: 700;
    color: #2F7D32;
    min-width: 50px;
    font-size: 0.85rem;
  }

  .obs-species {
    font-weight: 600;
    color: #142016;
    flex: 1;
    font-size: 0.85rem;
  }

  .obs-note {
    font-size: 0.75rem;
    color: #999;
  }

  .report-outputs {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid #E8DFD3;
    font-size: 0.9rem;
    color: #5E6B60;
  }

  .report-features h3 {
    margin-bottom: 1.5rem;
    color: #142016;
  }

  .report-checklist {
    list-style: none;
    margin-bottom: 2rem;
  }

  .report-checklist li {
    padding: 0.5rem 0;
    color: #5E6B60;
    font-size: 0.95rem;
  }

  .report-cta {
    text-align: center;
  }

  @media (max-width: 968px) {
    .report-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
