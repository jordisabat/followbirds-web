  .dot-6 { top: 70%; left: 55%; background: #FF6B35; }

  .map-line {
    position: absolute;
    background: rgba(47,125,50,0.2);
  }

  .line-h {
    left: 15%;
    right: 15%;
    top: 50%;
    height: 1px;
  }

  .line-v {
    top: 20%;
    bottom: 20%;
    left: 50%;
    width: 1px;
  }

  .map-legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 1rem;
    background: #FAF7EF;
