    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .map-frame img[src=""] ~ .map-placeholder-art,
  .map-frame img:not([src]) ~ .map-placeholder-art {
    display: flex;
  }

  .map-art-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .map-label-top {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.1rem;
    font-weight: 600;
    color: #2F7D32;
    opacity: 0.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .map-dot {
