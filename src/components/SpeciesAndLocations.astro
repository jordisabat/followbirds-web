<style>
  .two-panel-section {
    display: grid;
    grid-template-columns: 1fr 4px 1fr;
    background: #fff;
  }

  .panel {
    padding: 5.5rem 0;
  }

  .panel-left .panel-inner {
    max-width: 560px;
    margin-left: auto;
    padding: 0 3rem 0 1.5rem;
  }

  .panel-right .panel-inner {
    max-width: 560px;
    margin-right: auto;
    padding: 0 1.5rem 0 3rem;
  }

  .panel-divider {
    background: #EDE8DF;
    align-self: stretch;
  }

  .panel-subtitle {
    font-size: 0.95rem;
    color: #5E6B60;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  /* Species Grid */
  .species-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .species-card {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid #EDE8DF;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    background: #FAF7EF;
  }

  .species-card:hover {
    box-shadow: 0 6px 20px rgba(47,125,50,0.12);
    transform: translateY(-3px);
  }

  .species-photo {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    position: relative;
    background: #D4E8D0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .species-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .species-fallback {
    font-size: 2.5rem;
    position: absolute;
    display: none;
  }

  /* Show fallback when image errors */
  .species-photo.no-img img { display: none; }
  .species-photo.no-img .species-fallback { display: block; }

  /* When no image loaded yet, show fallback too */
  .species-photo img[src=""] ~ .species-fallback,
  .species-photo img:not([src]) ~ .species-fallback {
    display: block;
  }

  .species-info {
    padding: 0.6rem 0.75rem 0.75rem;
  }

  .species-info h3 {
    font-size: 0.8rem;
    font-weight: 600;
    color: #142016;
    margin: 0 0 0.2rem;
    line-height: 1.3;
  }

  .species-sci {
    font-size: 0.7rem;
    font-style: italic;
    color: #5E6B60;
    margin: 0;
    line-height: 1.2;
  }

  /* Map */
  .map-container {
    margin-bottom: 2rem;
  }

  .map-frame {
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid #EDE8DF;
    aspect-ratio: 4/3;
    background: #D8EDD4;
    position: relative;
  }

  .map-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

