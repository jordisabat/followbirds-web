---
// For Guides Section
---

<section id="for-guides" class="for-guides section">
  <div class="container">
    <div class="guides-grid">
      <div class="guides-visual">
        <div class="guide-mockup">
          <div style="font-size: 4rem; line-height: 1;">🧑‍🔭</div>
        </div>
      </div>

      <div class="guides-content">
        <h2>Join Guided Tours<br/>with Local Experts</h2>
        <p class="guides-subtitle">
          Learn from experienced birding guides who know Algarve's best locations and can help you spot rare species.
        </p>

        <div class="features">
          <div class="feature-item">
            <div class="feature-icon">✓</div>
            <div>
              <h3>Guided Excursions</h3>
              <p>Join expert-led birdwatching tours tailored to your experience level.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">📋</div>
            <div>
              <h3>Species Checklists</h3>
              <p>Track all species spotted during the tour with detailed information.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">🔍</div>
            <div>
              <h3>Real-Time Observations</h3>
              <p>See live sightings as the guide records them during the tour.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">📷</div>
            <div>
              <h3>Multi-user Bird<br/>Information</h3>
              <p>Share photos and observations with other tour participants.</p>
            </div>
          </div>
        </div>

        <div class="for-guides-cta">
          <a href="#" class="btn btn-secondary">Open Bird Library</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .for-guides {
    background-color: #fff;
    padding: 5.5rem 0;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .guides-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .guide-mockup {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #EAF3E5 0%, #D4E8D0 100%);
    border-radius: 1.5rem;
    border: 1px solid #C7E0C8;
    box-shadow: 0 12px 32px rgba(47, 125, 50, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .guides-content h2 {
    font-size: 2rem;
    color: #142016;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .guides-subtitle {
    font-size: 1.05rem;
    color: #5E6B60;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }

  .feature-item {
    display: flex;
    gap: 1.5rem;
  }

  .feature-icon {
    font-size: 1.8rem;
    min-width: 40px;
    text-align: center;
    line-height: 1;
    color: #2F7D32;
    font-weight: 600;
  }

  .feature-item h3 {
    color: #142016;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .feature-item p {
    color: #5E6B60;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .for-guides-cta {
    text-align: left;
  }

  @media (max-width: 1024px) {
    .guides-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .guide-mockup {
      max-width: 300px;
    }

    .guides-content h2 {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 768px) {
    .for-guides {
      padding: 4rem 0;
    }

    .guides-grid {
      gap: 2rem;
    }

    .guides-content h2 {
      font-size: 1.5rem;
    }

    .guides-subtitle {
      font-size: 1rem;
    }

    .features {
      gap: 1.5rem;
    }

    .guide-mockup {
      width: 100%;
      max-width: 100%;
    }

    .feature-item {
      gap: 1rem;
    }

    .feature-icon {
      font-size: 1.5rem;
    }

    .feature-item h3 {
      font-size: 0.95rem;
    }
  }
</style>
