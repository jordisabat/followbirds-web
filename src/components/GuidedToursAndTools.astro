---
// Join Guided Tours + Powerful Tools for Guides — two independent sections
---

<!-- SECTION 1: Join Guided Tours -->
<section id="for-guides" class="for-guides-section">
  <div class="container">
    <div class="guides-layout">
      <div class="guide-image-wrap">
        <div class="guide-image-frame">
          <img src="/guide-birdwatching.jpg" alt="Birding guide with group" loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
          <div class="guide-image-fallback">
            <div class="guide-icon">🧑‍🔭</div>
          </div>
        </div>
      </div>

      <div class="guides-text">
        <span class="section-label">For birding guides in Portugal</span>
        <h2>Built for Algarve birding guides</h2>
        <p class="guides-subtitle">
          Run better tours, record observations in real time, and give every guest a professional report.
        </p>

        <ul class="feature-checklist">
          <li>
            <span class="check-icon">✓</span>
            <span>Save time after tours</span>
          </li>
          <li>
            <span class="check-icon">✓</span>
            <span>Look more professional</span>
          </li>
          <li>
            <span class="check-icon">✓</span>
            <span>Reuse tour workflows</span>
          </li>
          <li>
            <span class="check-icon">✓</span>
            <span>Generate client-ready reports</span>
          </li>
        </ul>

        <a href="mailto:guides@followbirds.com" class="btn btn-primary">Join the Guide Program</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section 1: For Guides ── */
  .for-guides-section {
    background: #fff;
    padding: 5.5rem 0;
  }

  .guides-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .guide-image-frame {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 1.25rem;
    overflow: hidden;
    background: linear-gradient(135deg, #BBD6BC 0%, #99C19B 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
  }

  .guide-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .guide-image-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .guide-image-frame img[src=""] ~ .guide-image-fallback,
  .guide-image-frame img:not([src]) ~ .guide-image-fallback { display: flex; }

  .guide-icon { font-size: 5rem; opacity: 0.6; }

  .guides-subtitle {
    font-size: 1rem;
    color: #727272;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .feature-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .feature-checklist li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #111815;
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #F5F4F6;
    color: #559858;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .guides-layout { grid-template-columns: 1fr; gap: 3rem; }
  }

  @media (max-width: 640px) {
    .for-guides-section { padding: 4rem 0; }
  }
</style>

