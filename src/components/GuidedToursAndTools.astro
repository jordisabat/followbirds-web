---
// Join Guided Tours + Powerful Tools for Guides — two independent sections
---

<!-- SECTION 1: Join Guided Tours -->
<section id="for-guides" class="for-guides-section">
  <div class="container">
    <div class="guides-layout">
      <div class="guide-image-wrap">
        <div class="guide-image-frame">
          <img src="/guide-birdwatching.jpg" alt="Birding guide with group" loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
          <div class="guide-image-fallback">
            <div class="guide-icon">🧑‍🔭</div>
          </div>
        </div>
      </div>

      <div class="guides-text">
        <span class="section-label">Birdwatching guided by experts</span>
        <h2>Join Guided Tours with Local Experts</h2>
        <p class="guides-subtitle">
          Join experiences led by local birding guides and follow every observation directly through FollowBirds.
        </p>

        <ul class="feature-checklist">
          <li>
            <span class="check-icon">✓</span>
            <span>Guided Excursions</span>
          </li>
          <li>
            <span class="check-icon">✓</span>
            <span>Species Checklists</span>
          </li>
          <li>
            <span class="check-icon">✓</span>
            <span>Real-Time Observations</span>
          </li>
          <li>
            <span class="check-icon">✓</span>
            <span>Multilingual Bird Information</span>
          </li>
        </ul>

        <a href="#" class="btn btn-secondary">Open Bird Library</a>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 2: Powerful Tools for Guides -->
<section id="guide-program" class="tools-section">
  <div class="container">
    <div class="section-header">
      <div class="label-row">
        <span class="section-label">Built for Professional Birding Guides</span>
        <span class="coming-soon-badge">COMING SOON</span>
      </div>
      <h2>Powerful Tools for Birding Guides</h2>
      <p class="tools-subtitle">
        FollowBirds helps guides organize tours, manage participants, and generate professional reports.
      </p>
    </div>

    <div class="tools-grid">
      <div class="tool-item">
        <div class="tool-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/>
            <path d="M13 8h4M13 12h4M13 16h4"/>
          </svg>
        </div>
        <div>
          <h3>Tour Templates</h3>
          <p>Create reusable tour templates and use them repeatedly.</p>
        </div>
      </div>

      <div class="tool-item">
        <div class="tool-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <div>
          <h3>Tour Management</h3>
          <p>Schedule and manage individual tour dates.</p>
        </div>
      </div>

      <div class="tool-item">
        <div class="tool-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <h3>Participant Management</h3>
          <p>Invite and manage tour participants.</p>
        </div>
      </div>

      <div class="tool-item">
        <div class="tool-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        </div>
        <div>
          <h3>Shared Species Checklists</h3>
          <p>Help participants follow observations during the tour.</p>
        </div>
      </div>

      <div class="tool-item">
        <div class="tool-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <div>
          <h3>Tour Reports</h3>
          <p>Generate professional reports after each excursion.</p>
        </div>
      </div>

      <div class="tool-item">
        <div class="tool-icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <div>
          <h3>Multilingual Experience</h3>
          <p>Bird information displayed in multiple languages.</p>
        </div>
      </div>
    </div>

    <div class="tools-cta">
      <a href="mailto:guides@followbirds.com" class="btn btn-primary">Become a Guide</a>
    </div>
  </div>
</section>

<style>
  /* ── Section 1: For Guides ── */
  .for-guides-section {
    background: #fff;
    padding: 5.5rem 0;
  }

  .guides-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .guide-image-frame {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 1.25rem;
    overflow: hidden;
    background: linear-gradient(135deg, #C7E0C8 0%, #A6D5A3 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
  }

  .guide-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .guide-image-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .guide-image-frame img[src=""] ~ .guide-image-fallback,
  .guide-image-frame img:not([src]) ~ .guide-image-fallback { display: flex; }

  .guide-icon { font-size: 5rem; opacity: 0.6; }

  .guides-subtitle {
    font-size: 1rem;
    color: #5E6B60;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .feature-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .feature-checklist li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #142016;
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #EAF3E5;
    color: #2F7D32;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ── Section 2: Tools ── */
  .tools-section {
    background: #FAF7EF;
    padding: 5.5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .label-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }

  .coming-soon-badge {
    display: inline-block;
    background: #2F7D32;
    color: #fff;
    padding: 0.25rem 0.6rem;
    border-radius: 0.3rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .tools-subtitle {
    font-size: 1rem;
    color: #5E6B60;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .tool-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: #fff;
    border-radius: 0.75rem;
    border: 1px solid #EDE8DF;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .tool-item:hover {
    border-color: #2F7D32;
    box-shadow: 0 4px 12px rgba(47,125,50,0.08);
  }

  .tool-icon-wrap {
    width: 36px;
    height: 36px;
    background: #EAF3E5;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2F7D32;
    flex-shrink: 0;
  }

  .tool-item h3 {
    font-size: 0.85rem;
    font-weight: 600;
    color: #142016;
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }

  .tool-item p {
    font-size: 0.8rem;
    color: #5E6B60;
    line-height: 1.5;
    margin: 0;
  }

  .tools-cta {
    text-align: center;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .guides-layout { grid-template-columns: 1fr; gap: 3rem; }
    .tools-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .for-guides-section,
    .tools-section { padding: 4rem 0; }
    .tools-grid { grid-template-columns: 1fr; }
  }
</style>

