---
// What is FollowBirds Section
---

<section id="what-is-followbirds" class="what-is-followbirds section">
  <div class="container">
    <div class="section-header">
      <span class="section-label">What is FollowBirds</span>
      <h2>Everything You Need for<br/>Birdwatching in One Place</h2>
      <p class="section-subtitle">
        Whether you're exploring on your own or joining a guided tour, FollowBirds helps you discover birds, explore birding destinations, build your life list, and keep track of every observation.
      </p>
    </div>

    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </div>
        <span>Bird<br/>Discovery</span>
      </div>

      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <span>Bird<br/>Identification</span>
      </div>

      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <span>Birding<br/>Hotspots</span>
      </div>

      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <span>Guided<br/>Tours</span>
      </div>

      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        </div>
        <span>Personal<br/>Bird Lists</span>
      </div>

      <div class="feature-card">
        <div class="feature-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <span>Tour<br/>Reports</span>
      </div>
    </div>
  </div>
</section>

<style>
  .what-is-followbirds {
    background-color: #fff;
    padding: 5.5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .what-is-followbirds h2 {
    color: #142016;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1rem;
    color: #5E6B60;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
    margin-bottom: 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: 1.75rem 1rem;
    background: #FAF7EF;
    border-radius: 1rem;
    border: 1px solid #EDE8DF;
    text-align: center;
    transition: all 0.25s ease;
    cursor: default;
  }

  .feature-card:hover {
    border-color: #2F7D32;
    background: #fff;
    box-shadow: 0 6px 20px rgba(47,125,50,0.1);
    transform: translateY(-3px);
  }

  .feature-icon-wrap {
    width: 52px;
    height: 52px;
    background: #EAF3E5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2F7D32;
    flex-shrink: 0;
    transition: background 0.25s ease;
  }

  .feature-card:hover .feature-icon-wrap {
    background: #2F7D32;
    color: #fff;
  }

  .feature-card span {
    font-size: 0.82rem;
    font-weight: 600;
    color: #142016;
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .what-is-followbirds {
      padding: 4rem 0;
    }

    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }

    .feature-card {
      padding: 1.25rem 0.75rem;
    }

    .feature-icon-wrap {
      width: 44px;
      height: 44px;
    }
  }
</style>
