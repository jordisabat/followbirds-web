---
// Guide Program CTA Section (merged from GuideProgram + FinalCTA)
---

<section id="guide-program" class="guide-program-cta section">
  <div class="container">
    <h2>Become one of the first FollowBirds guides in Algarve.</h2>
    <p class="cta-subtitle">
      For private tours, group walks, hotel experiences and birding holidays.
    </p>

    <div class="cta-buttons">
      <a href="mailto:guides@followbirds.com" class="btn btn-primary btn-lg">Join the Guide Program</a>
      <a href="#reports" class="btn btn-secondary-light btn-lg">See Example Report</a>
    </div>
  </div>
</section>

<style>
  .guide-program-cta {
    background: linear-gradient(135deg, #2F7D32 0%, #1b5e20 100%);
    color: #fff;
    text-align: center;
  }

  .guide-program-cta h2 {
    color: #fff;
    margin-bottom: 1rem;
  }

  .cta-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    min-width: 200px;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.05rem;
  }

  .btn-secondary-light {
    background-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    border: 2px solid #fff;
    transition: all 0.2s ease;
  }

  .btn-secondary-light:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .guide-program-cta .btn-primary {
    background-color: #fff;
    color: #2F7D32;
  }

  .guide-program-cta .btn-primary:hover {
    background-color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 768px) {
    .cta-buttons {
      flex-direction: column;
    }

    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>
