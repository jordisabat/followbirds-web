---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ForGuides from '../components/ForGuides.astro';
import ExampleTourReport from '../components/ExampleTourReport.astro';
import ForBirdwatchers from '../components/ForBirdwatchers.astro';
import GuideProgramCTA from '../components/GuideProgramCTA.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const title = "FollowBirds — Birdwatching Tours, Checklists and Reports";
const description = "FollowBirds helps birding guides run tours and helps birdwatchers save observations, checklists and beautiful reports forever.";
---

<Layout title={title} description={description}>
  <Header />
  
  <main>
    <Hero />
    <HowItWorks />
    <ForGuides />
    <ExampleTourReport />
    <ForBirdwatchers />
    <GuideProgramCTA />
    <FAQ />
  </main>
  
  <Footer />
</Layout>
