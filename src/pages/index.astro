---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import GuidedToursAndTools from '../components/GuidedToursAndTools.astro';
import ReportsAndDashboard from '../components/ReportsAndDashboard.astro';
import FAQAndGrowth from '../components/FAQAndGrowth.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';

const title = "FollowBirds — The Complete Birdwatching Companion for Portugal";
const description = "Discover birds, explore birding hotspots, join guided tours, track sightings, and create lasting records of your birdwatching adventures.";
---

<Layout title={title} description={description}>
  <Header />
  
  <main>
    <Hero />
    <HowItWorks />
    <GuidedToursAndTools />
    <ReportsAndDashboard />
    <FAQAndGrowth />
    <FinalCTA />
  </main>
  
  <Footer />
</Layout>
