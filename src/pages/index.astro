---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import GuidedToursAndTools from '../components/GuidedToursAndTools.astro';
import ReportsAndDashboard from '../components/ReportsAndDashboard.astro';
import FAQAndGrowth from '../components/FAQAndGrowth.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';

const title = "Followbirds — The guide workspace for better birding tours";
const description = "Join the founding guide program and help shape Followbirds, a simpler way to create tours, share sightings, and give guests something worth keeping.";
---

<Layout title={title} description={description}>
  <Header />
  
  <main id="main-content">
    <Hero />
    <HowItWorks />
    <GuidedToursAndTools />
    <ReportsAndDashboard />
    <FAQAndGrowth />
    <FinalCTA />
  </main>
  
  <Footer />
</Layout>
